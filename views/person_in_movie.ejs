```html
<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Kaspar Rooste, veebiprogrammeerimine</title>
</head>
<body>
    <img src="pic/veebiprogrammeerimine_2026_TA.png" alt="">
    <h1>Seose loomine</h1>

    <p><%= notice || '' %></p>

    <form method="POST">
        <label for="personInput">Vali inimene:</label>
        <select name="personInput" id="personInput" required>
            <option value="">-- Vali inimene --</option>
            <% personList.forEach(person => { %>
                <option value="<%= person.id %>">
                    <%= person.first_name %> <%= person.last_name %>
                </option>
            <% }) %>
        </select>

        <br>

        <label for="movieInput">Vali film:</label>
        <select name="movieInput" id="movieInput" required>
            <option value="">-- Vali film --</option>
            <% movieList.forEach(movie => { %>
                <option value="<%= movie.id %>">
                    <%= movie.title %>
                </option>
            <% }) %>
        </select>

        <br>

        <label for="roleInput">Tegelase nimi:</label>
        <input type="text" id="roleInput" name="roleInput">

        <br>

        <label for="professionInput">Amet:</label>
        <select name="professionInput" id="professionInput">
            <option value="">-- Vali amet (valikuline) --</option>
            <% professionList.forEach(profession => { %>
                <option value="<%= profession.id %>">
                    <%= profession.title %>
                </option>
            <% }) %>
        </select>

        <br>

        <input type="submit" value="Salvesta">
    </form>
</body>
</html>
```