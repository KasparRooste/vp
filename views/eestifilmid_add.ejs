<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Kaspar Rooste, veebiprogrammeerimine</title>
</head>
<body>
    <img src="pic/veebiprogrammeerimine_2026_TA.png" alt="">
    <h1>Eesti filmid</h1>
    <p>Eesti filmid</p>

<p><%= notice || '' %></p>

    <form method="POST">

       <label for="movieNameInput">Filmi nimi</label>
       <input
           id="movieNameInput"
           name="movieNameInput"
           type="text"
           placeholder="film..."
           value="<%= movieNameInput || '' %>"
           required
       >

        <br>
        <label for="descriptionInput">Kirjeldus</label>


         <input
             id="descriptionInput"
             name="descriptionInput"
             type="text"
             placeholder="Kirjeldus..."
             value="<%= descriptionInput || '' %>"
             required
         >
         <br>

         <label for="releaseYearInput">Linastus aasta</label>
         <input
             id="releaseYearInput"
             name="releaseYearInput"
             type="number"
             min="1900" max="2026"
             value="<%= releaseYearInput || '' %>"
             required
         >
          <br>

         <label for="durationInput">Filmi pikkus minutites</label>
         <input
             id="durationInput"
             name="durationInput"
             type="number"
             min="1" max="360"
             value="<%= durationInput || '' %>"
             required
         >
         <br>
         <input id="movieSubmit" name = "movieSubmit" type="submit" value = "Salvesta">
        </form>

    <ul>
      <li><a href="/eestifilm">Eesti filmi</a></li>
    </ul>
</body>
</html>